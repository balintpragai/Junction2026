{
  "openapi": "3.1.0",
  "info": {
    "title": "Reach Loop API",
    "description": "Read-only public API: Regions, indicators, Gap summaries and outreach lists.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/regions": {
      "get": {
        "tags": [
          "lookups"
        ],
        "summary": "List Regions",
        "operationId": "list_regions_regions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionList"
                }
              }
            }
          }
        }
      }
    },
    "/indicators": {
      "get": {
        "tags": [
          "lookups"
        ],
        "summary": "List Indicators",
        "operationId": "list_indicators_indicators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorList"
                }
              }
            }
          }
        }
      }
    },
    "/regions/{code}/gap-summary": {
      "get": {
        "tags": [
          "gaps"
        ],
        "summary": "Gap Summary",
        "operationId": "gap_summary_regions__code__gap_summary_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "indicator",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Indicator code, e.g. '3621'",
              "title": "Indicator"
            },
            "description": "Indicator code, e.g. '3621'"
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Year, e.g. 2024",
              "title": "Year"
            },
            "description": "Year, e.g. 2024"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GapSummary"
                }
              }
            }
          },
          "404": {
            "description": "No Gap for this Region, indicator and year"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/outreach-list": {
      "get": {
        "tags": [
          "gaps"
        ],
        "summary": "Outreach List",
        "operationId": "outreach_list_outreach_list_get",
        "parameters": [
          {
            "name": "indicator",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Indicator code, e.g. '3621'",
              "title": "Indicator"
            },
            "description": "Indicator code, e.g. '3621'"
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Year, e.g. 2024",
              "title": "Year"
            },
            "description": "Year, e.g. 2024"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutreachList"
                }
              }
            }
          },
          "404": {
            "description": "No outreach list for this indicator and year"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/overview": {
      "get": {
        "tags": [
          "gaps"
        ],
        "summary": "Overview",
        "operationId": "overview_overview_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Year, e.g. 2024. Defaults to the latest scored year.",
              "title": "Year"
            },
            "description": "Year, e.g. 2024. Defaults to the latest scored year."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/regions/{code}/profile": {
      "get": {
        "tags": [
          "gaps"
        ],
        "summary": "Region Profile",
        "operationId": "region_profile_regions__code__profile_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Year, e.g. 2024. Defaults to the latest scored year.",
              "title": "Year"
            },
            "description": "Year, e.g. 2024. Defaults to the latest scored year."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionProfile"
                }
              }
            }
          },
          "404": {
            "description": "Unknown Region, or no Gap for this Region and year"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/regions/{code}/action-library": {
      "get": {
        "tags": [
          "gaps"
        ],
        "summary": "Action Library",
        "operationId": "action_library_regions__code__action_library_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionLibrary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown Region"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionLibrary": {
        "properties": {
          "region_code": {
            "type": "string",
            "title": "Region Code"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/CandidateAction"
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region_code",
          "actions"
        ],
        "title": "ActionLibrary",
        "description": "Every curated National Cancer Strategy action, in CandidateAction shape, so a\ndecision-maker can search the whole strategy rather than only what the rules matched."
      },
      "CandidateAction": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "strategy",
              "covariate"
            ],
            "title": "Kind"
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "title": "Why",
            "description": "The evidence for this action, with its figures filled in."
          },
          "workflow": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StakeholderWorkflow"
              },
              {
                "$ref": "#/components/schemas/PatientWorkflow"
              }
            ],
            "title": "Workflow"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "recommended",
          "title",
          "description",
          "why",
          "workflow"
        ],
        "title": "CandidateAction",
        "description": "Something a decision-maker could do about this Region's Gaps.\n\n`recommended` is True when the rules matched this action to a Gap in this\nRegion, and False for an action picked by hand out of the full strategy\nlibrary. Deterministic either way — no model decides this."
      },
      "CovariateMeta": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "median": {
            "type": "number",
            "title": "Median",
            "description": "Median across every Region with a value in this year."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "unit",
          "median"
        ],
        "title": "CovariateMeta",
        "description": "How to read one covariate: its name, unit, and the national median it is compared against."
      },
      "CovariateValue": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Indicator id of the covariate, e.g. 'foreign_background_pct'."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "year": {
            "type": "integer",
            "title": "Year",
            "description": "Year of the value: always the outreach list's year (no fallback to other years)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name",
          "unit",
          "value",
          "year"
        ],
        "title": "CovariateValue",
        "description": "One structural covariate for one Region. Describes the Region, not individuals."
      },
      "DataQualityNote": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "DataQualityNote"
      },
      "Gap": {
        "properties": {
          "region_code": {
            "type": "string",
            "title": "Region Code"
          },
          "indicator_code": {
            "type": "string",
            "title": "Indicator Code"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "reference_kind": {
            "type": "string",
            "enum": [
              "target",
              "peer_median"
            ],
            "title": "Reference Kind"
          },
          "reference_value": {
            "type": "number",
            "title": "Reference Value",
            "description": "The Target, or the peer median."
          },
          "deviation": {
            "type": "number",
            "title": "Deviation",
            "description": "value − reference_value, signed, in the indicator's unit."
          },
          "direction": {
            "type": "string",
            "enum": [
              "above",
              "below",
              "at"
            ],
            "title": "Direction"
          },
          "severity": {
            "type": "string",
            "enum": [
              "ok",
              "watch",
              "act"
            ],
            "title": "Severity"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank",
            "description": "Position among n_regions; 1 = best performing."
          },
          "n_regions": {
            "type": "integer",
            "minimum": 1.0,
            "title": "N Regions"
          },
          "peer_values": {
            "items": {
              "$ref": "#/components/schemas/PeerValue"
            },
            "type": "array",
            "title": "Peer Values",
            "description": "Values of the other Regions in the same parent area, for the same indicator and year. Regions without a value that year are left out; empty when there are no peers (e.g. Åland)."
          },
          "trend_5y": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trend 5Y",
            "description": "Change in value over the last five years, in the indicator's unit; null if too little history."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region_code",
          "indicator_code",
          "year",
          "value",
          "reference_kind",
          "reference_value",
          "deviation",
          "direction",
          "severity",
          "rank",
          "n_regions",
          "peer_values",
          "trend_5y"
        ],
        "title": "Gap",
        "description": "How far one Region's value on one indicator, in one year, sits from its\nTarget (or from the other Regions when there is no Target)."
      },
      "GapEntry": {
        "properties": {
          "indicator": {
            "$ref": "#/components/schemas/Indicator"
          },
          "gap": {
            "$ref": "#/components/schemas/Gap"
          },
          "narrative": {
            "$ref": "#/components/schemas/Narrative"
          },
          "data_quality_notes": {
            "items": {
              "$ref": "#/components/schemas/DataQualityNote"
            },
            "type": "array",
            "title": "Data Quality Notes"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StrategyAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "trend": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Trend",
            "description": "Series for the sparkline, ascending by year."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "indicator",
          "gap",
          "narrative",
          "data_quality_notes",
          "action",
          "trend"
        ],
        "title": "GapEntry",
        "description": "One scored indicator inside a RegionProfile — the three-layer card's data.\n\nThe same content as a `GapSummary` minus its `region`, which the profile\ncarries once for every entry."
      },
      "GapSummary": {
        "properties": {
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "indicator": {
            "$ref": "#/components/schemas/Indicator"
          },
          "gap": {
            "$ref": "#/components/schemas/Gap"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StrategyAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_quality_notes": {
            "items": {
              "$ref": "#/components/schemas/DataQualityNote"
            },
            "type": "array",
            "title": "Data Quality Notes"
          },
          "narrative": {
            "$ref": "#/components/schemas/Narrative"
          },
          "trend": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Trend",
            "description": "Series for the sparkline, ascending by year."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region",
          "indicator",
          "gap",
          "action",
          "data_quality_notes",
          "narrative",
          "trend"
        ],
        "title": "GapSummary",
        "description": "Everything the three-layer card needs, in one round-trip."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Indicator": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Sotkanet indicator id, e.g. '3621'."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Unit of `value`, e.g. '%'."
          },
          "higher_is_better": {
            "type": "boolean",
            "title": "Higher Is Better"
          },
          "target": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target",
            "description": "National Cancer Strategy Target, or null when the indicator has none."
          },
          "cancer_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancer Type",
            "description": "Cancer site this indicator is specific to, e.g. 'breast'; 'all' for all sites. Null when the indicator is not cancer-specific, as the capacity and referral measures are."
          },
          "years": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Years",
            "description": "Years with data, ascending."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name",
          "unit",
          "higher_is_better",
          "target",
          "years"
        ],
        "title": "Indicator"
      },
      "IndicatorList": {
        "properties": {
          "indicators": {
            "items": {
              "$ref": "#/components/schemas/Indicator"
            },
            "type": "array",
            "title": "Indicators"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "indicators"
        ],
        "title": "IndicatorList"
      },
      "Narrative": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "source": {
            "type": "string",
            "enum": [
              "llm",
              "template"
            ],
            "title": "Source"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fi"
            ],
            "title": "Language"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "source",
          "language"
        ],
        "title": "Narrative",
        "description": "Plain-language sentence(s) describing one Gap. Every figure comes from the Gap."
      },
      "OutreachCovariates": {
        "properties": {
          "immigrant_background_share_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Immigrant Background Share Pct",
            "description": "Share of the Region's population with a foreign background (Statistics Finland), %. The same value as the 'foreign_background_pct' entry in `values`; null when there is no value in the list's year."
          },
          "values": {
            "items": {
              "$ref": "#/components/schemas/CovariateValue"
            },
            "type": "array",
            "title": "Values",
            "description": "Every loaded covariate that has a value for this Region in the list's year, sorted by code. A covariate with no value that year is left out (no fallback to an earlier or later year). Region-level only: see the list's ecological_fallacy_note before reading any of them as a cause."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "immigrant_background_share_pct",
          "values"
        ],
        "title": "OutreachCovariates"
      },
      "OutreachList": {
        "properties": {
          "indicator": {
            "$ref": "#/components/schemas/Indicator"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "reference_kind": {
            "type": "string",
            "enum": [
              "target",
              "peer_median"
            ],
            "title": "Reference Kind"
          },
          "reference_value": {
            "type": "number",
            "title": "Reference Value"
          },
          "ecological_fallacy_note": {
            "type": "string",
            "minLength": 1,
            "title": "Ecological Fallacy Note",
            "description": "Required caveat: Region-level associations do not describe individuals. The UI must show it."
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/OutreachRow"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "indicator",
          "year",
          "reference_kind",
          "reference_value",
          "ecological_fallacy_note",
          "rows"
        ],
        "title": "OutreachList",
        "description": "Regions on the wrong side of the indicator's Target (below it, or above it when lower is\nbetter), ranked by Gap, joined with covariates. Only indicators with a Target have one."
      },
      "OutreachRow": {
        "properties": {
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "deviation": {
            "type": "number",
            "title": "Deviation"
          },
          "severity": {
            "type": "string",
            "enum": [
              "ok",
              "watch",
              "act"
            ],
            "title": "Severity"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank",
            "description": "1 = largest Gap on the wrong side of the Target."
          },
          "covariates": {
            "$ref": "#/components/schemas/OutreachCovariates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region",
          "value",
          "deviation",
          "severity",
          "rank",
          "covariates"
        ],
