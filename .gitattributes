# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must keep LF on every OS: with CRLF, Git Bash fails on line 1
# ($'\r': command not found). Matters on Windows, where core.autocrlf=true is the default.
*.sh text eol=lf

# Generated by scripts/gen-api-types.sh with LF on every OS; keep the checkout
# identical to what the script writes.
web/openapi.json text eol=lf
web/src/lib/api-types.ts text eol=lf
