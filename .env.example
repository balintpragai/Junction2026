# Copy to .env and adjust. Every value has a working default in compose.yaml,
# so `docker compose up` also works from a clean clone without a .env file.
# Never commit .env (it is gitignored).

# --- Postgres (db container) ---
POSTGRES_USER=reachloop
# Local-only password: db publishes no port. Change it on any shared host.
POSTGRES_PASSWORD=reachloop
POSTGRES_DB=reachloop

# --- Service URLs (compose network names) ---
DATABASE_URL=postgresql://reachloop:reachloop@db:5432/reachloop
ENGINE_URL=http://engine:8000
NARRATIVE_URL=http://narrative:8000

# --- LLM (narrative only; OpenAI-compatible API). Leave empty to use Template sentences only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Public ports and origins ---
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
